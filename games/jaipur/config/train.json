{
  "network": {
    "type": "token_transformer",
    "d_model": 128,
    "num_layers": 4,
    "num_heads": 4,
    "ffn_dim": 256
  },
  "training": {
    "episodes_per_step": 200,
    "batch_size": 1024,
    "train_batches_per_step": 8,
    "learning_rate": 2e-4,
    "lr_schedule": {
      "type": "cosine",
      "lr_min": 4e-6
    },
    "steps": 5000,
    "replay_buffer_size": 200000,
    "eval_benchmarks": ["heuristic_free"],
    "selfplay_concurrency": {
      "enabled": true,
      "leaf_batch_size": 8,
      "opponent_pool_max_distinct": 10,
      "evaluator": {
        "batch_size": 1024,
        "batch_timeout_us": 30,
        "max_queue_size": 4096,
        "intra_op_num_threads": 1,
        "num_inference_threads": 2,
        "providers": []
      }
    }
  },
  "mcts": {
    "selfplay": {
      "dirichlet_alpha": 1.0,
      "dirichlet_epsilon": 0.25,
      "simulations": 800,
      "temperature": 1.0,
      "temperature_schedule": {
        "enabled": true,
        "initial": 1.0,
        "final": 0.1,
        "decay_plies": 30
      }
    },
    "eval": {
      "simulations": 800
    }
  },
  "heuristic_guidance": {
    "name": "rule_mcts",
    "hold_steps": 100,
    "steps": 200,
    "initial_ratio": 1.0,
    "temperature": 0.0
  },
  "runtime": {
    "eval_every": 100,
    "eval_games": 100,
    "save_every": 100
  }
}
