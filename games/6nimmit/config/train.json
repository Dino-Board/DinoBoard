{
  "network": {
    "type": "token_transformer",
    "d_model": 128,
    "num_layers": 4,
    "num_heads": 4,
    "ffn_dim": 256,
    "attention": "fused",
    "relative_position_radius": 8,
    "anchor_embedding": false
  },
  "training": {
    "steps": 10000,
    "episodes_per_step": 16,
    "batch_size": 1024,
    "learning_rate": 0.0002,
    "lr_schedule": {
      "type": "cosine",
      "lr_min": 4e-06
    },
    "grad_clip_norm": 1.0,
    "weight_decay": 0.0001,
    "train_batches_per_step": 3,
    "simulations_start": 1000,
    "opponent_pool_enabled": true,
    "opponent_pool_self_ratio": 0.5,
    "inference_precision": "fp16",
    "eval_benchmarks": [
      "heuristic_free"
    ],
    "selfplay_concurrency": {
      "enabled": true,
      "leaf_batch_size": 1,
      "opponent_pool_max_distinct": 3,
      "evaluator": {
        "batch_size": 100,
        "batch_timeout_us": 30,
        "max_queue_size": 256,
        "intra_op_num_threads": 1,
        "num_inference_threads": 1,
        "providers": []
      }
    }
  },
  "mcts": {
    "selfplay": {
      "dirichlet_alpha": 1.0,
      "dirichlet_epsilon": 0.25,
      "simulations": 1000,
      "temperature": 1.0,
      "temperature_schedule": {
        "enabled": true,
        "initial": 1.0,
        "final": 0.5,
        "decay_plies": 20
      }
    },
    "eval": {
      "simulations": 1000
    }
  },
  "heuristic_guidance": {
    "name": "rule_v1",
    "hold_steps": 100,
    "steps": 200,
    "initial_ratio": 1.0,
    "temperature": 0.0
  },
  "runtime": {
    "eval_every": 100,
    "eval_games": 50,
    "save_every": 25,
    "seed": 20261112
  }
}
