{
  "network": {
    "type": "mlp",
    "hidden_layers": [512, 512, 512, 512, 512, 512, 512, 512],
    "activation": "relu",
    "residual": true,
    "block_size": 2
  },
  "training": {
    "episodes_per_step": 100,
    "batch_size": 2048,
    "train_batches_per_step": 10,
    "replay_buffer_size": 200000,
    "opponent_pool_enabled": true,
    "opponent_pool_self_ratio": 0.5,
    "learning_rate": 0.0001,
    "lr_schedule": {
      "type": "cosine",
      "lr_min": 5e-06
    },
    "steps": 20000,
    "eval_benchmarks": ["heuristic_free"],
    "selfplay_concurrency": {
      "enabled": true,
      "leaf_batch_size": 1,
      "opponent_pool_max_distinct": 10,
      "evaluator": {
        "batch_size": 100,
        "batch_timeout_us": 30,
        "max_queue_size": 256,
        "intra_op_num_threads": 1,
        "num_inference_threads": 1,
        "providers": []
      }
    }
  },
  "mcts": {
    "selfplay": {
      "dirichlet_alpha": 0.3,
      "dirichlet_epsilon": 0.25,
      "simulations": 1000,
      "temperature": 1.0,
      "temperature_schedule": {
        "enabled": true,
        "initial": 1.0,
        "final": 0.1,
        "decay_plies": 60
      }
    },
    "eval": {
      "simulations": 1000
    }
  },
  "heuristic_guidance": {
    "name": "greedy_mcts_train",
    "hold_steps": 300,
    "steps": 600,
    "initial_ratio": 1.0,
    "temperature": 0.0
  },
  "runtime": {
    "eval_every": 100,
    "eval_games": 100,
    "save_every": 25
  }
}
