{
  "network": {
    "type": "token_transformer",
    "d_model": 192,
    "num_layers": 6,
    "num_heads": 6,
    "ffn_dim": 384,
    "attention": "fused",
    "relative_position_radius": 6,
    "anchor_embedding": false
  },
  "training": {
    "steps": 20000,
    "episodes_per_step": 200,
    "batch_size": 1024,
    "learning_rate": 0.0002,
    "lr_schedule": {
      "type": "cosine",
      "lr_min": 4e-06
    },
    "grad_clip_norm": 1.0,
    "weight_decay": 0.0001,
    "train_batches_per_step": 10,
    "replay_buffer_size": 300000,
    "opponent_pool_enabled": true,
    "opponent_pool_self_ratio": 0.75,
    "opening_exploration": {
      "episode_ratio": 0.3,
      "min_plies": 2,
      "max_plies": 20,
      "temperature": 1.25,
      "uniform_mix": 0.2
    },
    "compact_replay": {
      "features_dtype": "float16"
    },
    "symmetry_augmentation": true,
    "playout_cap": {
      "full_simulations": 800,
      "fast_simulations": 150,
      "full_search_prob": 0.25
    },
    "score_head": {
      "loss_weight": 0.5,
      "scale": 15.0
    },
    "opponent_policy_head": {
      "loss_weight": 0.15
    },
    "ema": {
      "decay": 0.99
    },
    "inference_precision": "fp16",
    "eval_benchmarks": [
      "heuristic_free"
    ],
    "selfplay_concurrency": {
      "enabled": true,
      "leaf_batch_size": 32,
      "opponent_pool_max_distinct": 3,
      "evaluator": {
        "batch_size": 1024,
        "batch_timeout_us": 30,
        "max_queue_size": 8192,
        "intra_op_num_threads": 1,
        "num_inference_threads": 2,
        "providers": []
      }
    }
  },
  "heuristic_guidance": {
    "name": "greedy_mcts_train",
    "hold_steps": 100,
    "steps": 400,
    "initial_ratio": 1.0,
    "temperature": 0.0
  },
  "runtime": {
    "workers": 200,
    "eval_every": 100,
    "eval_games": 200,
    "save_every": 50,
    "seed": 20261111
  }
}
