{
  "network": {
    "type": "mlp",
    "hidden_layers": [
      256,
      256
    ],
    "activation": "relu",
    "residual": false,
    "block_size": 2
  },
  "training": {
    "episodes_per_step": 100,
    "batch_size": 256,
    "train_batches_per_step": 5,
    "learning_rate": 0.0005,
    "lr_schedule": {
      "type": "cosine",
      "lr_min": 1e-05
    },
    "steps": 1000,
    "eval_benchmarks": [
      "heuristic_free"
    ]
  },
  "mcts": {
    "selfplay": {
      "dirichlet_alpha": 2.0,
      "dirichlet_epsilon": 0.25,
      "simulations": 1000,
      "temperature": 1.0,
      "temperature_schedule": {
        "enabled": true,
        "initial": 1.0,
        "final": 0.1,
        "decay_plies": 8
      }
    },
    "eval": {
      "simulations": 100
    }
  },
  "heuristic_guidance": {
    "name": "rule",
    "hold_steps": 0,
    "steps": 0,
    "initial_ratio": 0.0,
    "temperature": 0.0
  },
  "runtime": {
    "eval_every": 100,
    "eval_games": 100,
    "save_every": 100
  }
}
